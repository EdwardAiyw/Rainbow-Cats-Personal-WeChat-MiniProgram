<view class="page">
  <view class="hero"><view class="eyebrow">{{copy.eyebrow}}</view><view class="hero-title">{{copy.heroTitle}}</view><view class="hero-subtitle">{{copy.heroSubtitle}}</view></view>
  <view wx:if="{{!configured}}" class="card notice">{{copy.configure}}</view>
  <view wx:elif="{{loading}}" class="card empty"><view class="icon">*</view><view class="title">{{copy.loading}}</view></view>
  <view wx:elif="{{!space}}" class="card">
    <view class="heading">{{copy.createTitle}}</view><view class="muted">{{copy.createHint}}</view>
    <input type="text" cursor-spacing="20" maxlength="12" placeholder="{{namePlaceholder}}" placeholder-class="input-placeholder" bindinput="onNameInput" value="{{displayName}}" />
    <button loading="{{submitting}}" disabled="{{submitting}}" bindtap="createSpace">{{copy.create}}</button>
    <view wx:if="{{createCode}}" class="invite">{{copy.invite}}<text selectable="true">{{createCode}}</text></view>
    <view class="divider">OR</view>
    <input type="text" cursor-spacing="20" maxlength="12" placeholder="{{codePlaceholder}}" placeholder-class="input-placeholder" bindinput="onCodeInput" value="{{inviteCode}}" />
    <button class="secondary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="joinSpace">{{copy.join}}</button>
  </view>
  <block wx:else>
    <view class="card"><view class="heading heading-with-action"><text>{{copy.points}}</text><button wx:if="{{!editingName}}" class="name-edit" size="mini" bindtap="editDisplayNameInline">修改昵称</button></view><view wx:if="{{editingName}}" class="name-editor"><input class="name-input" type="text" focus="{{nameInputFocus}}" cursor-spacing="24" maxlength="12" value="{{editingNameValue}}" bindinput="onEditingNameInput" bindconfirm="saveDisplayNameInline" confirm-type="done" /><view class="name-editor-actions"><button class="name-cancel" size="mini" bindtap="cancelEditDisplayNameInline">取消</button><button class="name-save" size="mini" bindtap="saveDisplayNameInline">保存</button></view></view><view wx:for="{{members}}" wx:key="_id" class="member-row"><text>{{item.displayName}}</text><text>{{item.credit}} {{copy.pointUnit}}</text></view></view>
    <view class="card"><view class="heading">{{copy.connected}}</view><view class="invite"><text selectable="true">{{space.inviteCode}}</text></view><button class="secondary" bindtap="copyInviteCode">{{copy.copyCode}}</button><button wx:if="{{notificationConfigured}}" bindtap="requestSubscribeMessage">{{copy.notify}}</button><view wx:else class="notice">{{copy.notifyHint}}</view></view>
  </block>
</view>
