<view class="page">
  <view class="heading-with-action"><view class="page-heading">{{l.title}}</view><button class="settings-button" size="mini" bindtap="openSettings">设置</button></view><view class="muted">{{l.hint}}</view>
  <view wx:if="{{loading}}" class="card empty"><view class="icon">*</view><view class="title">{{l.loading}}</view></view>
  <view wx:elif="{{errorText}}" class="card status-card"><view class="status-title">{{l.errorTitle}}</view><view class="status-message">{{errorText}}</view><button bindtap="retry">{{l.retry}}</button></view>
  <view wx:elif="{{!hasSpace}}" class="card status-card"><view class="status-title">{{l.noSpaceTitle}}</view><view class="status-message">{{l.noSpaceHint}}</view><button bindtap="openSpace">{{l.goSpace}}</button></view>
  <block wx:else>
    <view class="form-group search-bar"><input class="search-input" type="text" cursor-spacing="20" confirm-type="search" placeholder="{{l.search}}" bindinput="onSearch" value="{{search}}" /></view>
    <view wx:if="{{allItems.length === 0}}" class="card empty"><view class="icon">*</view><view class="title">{{l.empty}}</view></view>
    <block wx:else><view class="section-title"><text>{{l.unused}}</text><text>{{unusedItems.length}}</text></view><view wx:for="{{unusedItems}}" wx:key="_id" class="card slide" data-index="{{index}}" bindtap="toDetailPageUpper"><view class="item-info"><view class="item-info_title">{{item.title}}</view><view class="item-info_date">{{l.ready}}</view></view><view class="item-actions"><button size="mini" data-id="{{item._id}}" bindtap="useItem">{{l.use}}</button><button size="mini" class="secondary" data-id="{{item._id}}" bindtap="toggleStar">{{item.star ? '*' : '+'}}</button><button size="mini" class="secondary" data-id="{{item._id}}" bindtap="deleteItem">{{l.delete}}</button></view></view><view class="section-title"><text>{{l.used}}</text><text>{{usedItems.length}}</text></view><view wx:for="{{usedItems}}" wx:key="_id" class="card slide done" data-index="{{index}}" bindtap="toDetailPageLower"><view class="item-info"><view class="item-info_title">{{item.title}}</view><view class="item-info_date">{{l.done}}</view></view></view></block>
  </block>
</view>
