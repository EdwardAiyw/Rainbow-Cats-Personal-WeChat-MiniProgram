<view class="container" wx:if="{{item}}">
  <view class="page-heading">{{copy.pageTitle}}</view>
  <view class="card"><view class="detail-label">{{copy.title}}</view><view class="detail-value">{{item.title}}</view></view>
  <view class="card"><view class="detail-label">{{copy.relation}}</view><view class="detail-value">{{from}} {{copy.listed}} {{to}} {{copy.exchange}}</view></view>
  <view class="card"><view class="detail-label">{{copy.value}} · {{item.credit}} {{copy.point}}</view><progress percent="{{creditPercent}}" color="#ff4e76" activeColor="#ff4e76" stroke-width="8" /><view class="muted">{{copy.maximum}} {{maxCredit}} {{copy.point}}</view></view>
  <view class="card"><view class="detail-label">{{copy.createdAt}}</view><view class="detail-value">{{dateStr}} {{timeStr}}</view></view>
  <view class="card"><view class="detail-label">{{copy.detail}}</view><view class="detail-value">{{item.desc || '-'}}</view></view>
</view>
<view wx:else class="container empty"><view class="title">{{copy.notFound}}</view></view>
