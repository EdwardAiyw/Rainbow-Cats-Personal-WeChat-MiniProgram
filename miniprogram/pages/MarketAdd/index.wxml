<view class="container">
  <view class="page-heading">{{copy.pageTitle}}</view><view class="muted">{{copy.hint}}</view>
  <view class="card">
    <view class="form-label">{{copy.preset}}</view><picker mode="selector" bindchange="onPresetChange" value="{{presetIndex}}" range="{{presets}}" range-key="name"><view class="input">{{presets[presetIndex].name}}</view></picker>
    <view class="form-label">{{copy.title}}</view><input type="text" cursor-spacing="20" maxlength="12" placeholder="{{titlePlaceholder}}" placeholder-class="input-placeholder" bindinput="onTitleInput" value="{{title}}" />
    <view class="form-label">{{copy.detail}}</view><textarea cursor-spacing="20" maxlength="100" placeholder="{{descPlaceholder}}" placeholder-class="input-placeholder" bindinput="onDescInput" value="{{desc}}" />
    <view class="form-label">{{copy.credit}}：{{credit}}</view><slider min="1" max="{{maxCredit}}" value="{{credit}}" activeColor="#ff4e76" bindchange="onCreditInput" show-value />
  </view>
  <view class="footer"><view class="reset" bindtap="resetItem">{{copy.reset}}</view><view class="save" bindtap="saveItem">{{submitting ? '...' : copy.save}}</view></view>
</view>
