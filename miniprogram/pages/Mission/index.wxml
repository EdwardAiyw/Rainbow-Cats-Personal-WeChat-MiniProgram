<view class="page">
  <view class="page-heading">{{l.title}}</view><view class="muted">{{l.hint}}</view>
  <view wx:if="{{loading}}" class="card empty"><view class="icon">*</view><view class="title">{{l.loading}}</view></view>
  <view wx:elif="{{errorText}}" class="card status-card"><view class="status-title">{{l.errorTitle}}</view><view class="status-message">{{errorText}}</view><button bindtap="retry">{{l.retry}}</button></view>
  <view wx:elif="{{!hasSpace}}" class="card status-card"><view class="status-title">{{l.noSpaceTitle}}</view><view class="status-message">{{l.noSpaceHint}}</view><button bindtap="openSpace">{{l.goSpace}}</button></view>
  <block wx:else>
    <view class="form-group search-bar"><input class="search-input" type="text" cursor-spacing="20" confirm-type="search" placeholder="{{l.search}}" bindinput="onSearch" value="{{search}}" /></view>
    <view wx:if="{{allMissions.length === 0}}" class="card empty"><view class="icon">*</view><view class="title">{{l.empty}}</view></view>
    <block wx:else>
      <view class="section-title"><text>{{l.pending}}</text><text>{{unfinishedMissions.length}}</text></view>
      <view wx:for="{{unfinishedMissions}}" wx:key="_id" class="card slide" data-index="{{index}}" bindtap="toDetailPageUpper"><view class="mission-info"><view class="mission-info_title">{{item.title}}</view><view class="mission-info_award">{{l.reward}} {{item.credit}} {{l.point}}</view><view class="mission-info_date">{{item.desc}}</view></view><view class="item-actions"><button size="mini" data-id="{{item._id}}" bindtap="completeMission">{{l.complete}}</button><button size="mini" class="secondary" data-id="{{item._id}}" bindtap="toggleStar">{{item.star ? '*' : '+'}}</button><button size="mini" class="secondary" data-id="{{item._id}}" bindtap="deleteMission">{{l.delete}}</button></view></view>
      <view class="section-title"><text>{{l.completed}}</text><text>{{finishedMissions.length}}</text></view>
      <view wx:for="{{finishedMissions}}" wx:key="_id" class="card slide done" data-index="{{index}}" bindtap="toDetailPageLower"><view class="mission-info"><view class="mission-info_title">{{item.title}}</view><view class="mission-info_date">{{l.done}} {{item.credit}} {{l.point}}</view></view></view>
    </block>
    <button class="fab" bindtap="toAddPage">+</button>
  </block>
</view>
