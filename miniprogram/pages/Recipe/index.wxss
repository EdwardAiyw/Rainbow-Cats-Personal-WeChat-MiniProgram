.recipe-page { padding-top: 40rpx; }
.random-card { position: relative; padding-right: 220rpx; border-color: #ffe0a8; background: #fffaf0; }
.random-meta { display: flex; align-items: center; gap: 10rpx; color: #ff4e76; font-size: 24rpx; font-weight: 800; }
.random-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.random-title { margin-top: 10rpx; color: #332456; font-size: 38rpx; font-weight: 800; }
.random-desc { margin-top: 8rpx; color: #756b8f; font-size: 25rpx; line-height: 1.5; }
.random-card button { position: absolute; right: 24rpx; top: 50%; width: 170rpx; transform: translateY(-50%); font-size: 24rpx; }
.recipe-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin: 18rpx 2rpx 8rpx; }
.recipe-toolbar_copy { flex: 1; min-width: 0; color: #756b8f; font-size: 24rpx; line-height: 1.5; }
.recipe-toolbar_add { flex-shrink: 0; width: auto; padding: 0 22rpx; height: 62rpx; line-height: 62rpx; font-size: 24rpx; }
.recipe-search { display: flex; align-items: center; gap: 14rpx; margin: 20rpx 0 8rpx; }
.recipe-search .search-bar { flex: 1; min-width: 0; margin: 0; }
.search-button { flex-shrink: 0; width: 170rpx; height: 72rpx; line-height: 72rpx; padding: 0; font-size: 23rpx; }
.compact { padding: 42rpx 24rpx; }
.compact .title { font-size: 28rpx; }
.recipe-badge { flex-shrink: 0; margin-left: 14rpx; padding: 8rpx 14rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 800; }
.recipe-badge.preset { background: #fff3c9; color: #9a6200; }
.recipe-badge.custom { background: #d9f8ec; color: #08785a; }
.recipe-badge.official { background: #e7ddff; color: #5630d6; }
