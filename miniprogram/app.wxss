page { background: #fff8ee; color: #322456; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; -webkit-text-size-adjust: 100%; }
button { margin: 0; border: 0; border-radius: 999rpx; background: linear-gradient(110deg, #ff3f78, #ff7b38); color: #fff; font-size: 28rpx; font-weight: 700; -webkit-appearance: none; }
button::after { border: 0; } button[disabled] { opacity: .55; }
.container, .page { box-sizing: border-box; min-height: 100vh; padding: 32rpx 28rpx 154rpx; padding-bottom: calc(154rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(154rpx + env(safe-area-inset-bottom)); }
.page { background: radial-gradient(circle at 0 0, #dff8ff 0, transparent 34%), radial-gradient(circle at 100% 13%, #ffe1ad 0, transparent 27%), #fff8ee; }
.container { background: radial-gradient(circle at 0 0, #e7ddff 0, transparent 34%), #fff8ee; }
.card, .form-group { box-sizing: border-box; margin-bottom: 24rpx; padding: 28rpx; border: 2rpx solid #eadfff; border-radius: 28rpx; background: #fff; box-shadow: 0 14rpx 34rpx rgba(87,46,171,.12); }
.heading, .page-heading { margin-bottom: 16rpx; color: #5630d6; font-size: 40rpx; font-weight: 800; }
.muted, .notice, .subtitle { color: #756b8f; font-size: 25rpx; line-height: 1.65; }
.notice { padding: 20rpx; border-radius: 18rpx; background: #fff3c9; color: #895b00; }
.input, input, textarea { box-sizing: border-box; display: block; width: 100%; margin: 12rpx 0; padding: 22rpx 24rpx; border: 2rpx solid #ded4ff; border-radius: 18rpx; background: #fbfaff; color: #332456; -webkit-text-fill-color: #332456; opacity: 1; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 28rpx; }
input { height: 84rpx; line-height: 40rpx; -webkit-user-select: text; user-select: text; }
input, textarea { caret-color: #5630d6; }
textarea { min-height: 180rpx; line-height: 1.6; } .input-placeholder { color: #968da9; -webkit-text-fill-color: #968da9; opacity: 1; }
.secondary { background: #d9f8ec; color: #08785a; }
.divider { display: flex; align-items: center; gap: 16rpx; margin: 22rpx 0; color: #8c82a0; }.divider::before, .divider::after { content: ''; flex: 1; height: 2rpx; background: #e3dcf1; }
.invite { margin-top: 18rpx; padding: 18rpx; border: 2rpx dashed #ff9b3d; border-radius: 16rpx; background: #fff5e9; color: #ae4b00; text-align: center; }
.member-row { display: flex; justify-content: space-between; padding: 20rpx 0; border-top: 2rpx solid #f0ebf8; color: #3f2e6f; }
.hero { padding: 48rpx 8rpx 34rpx; }.eyebrow { color: #ff4d84; font-size: 24rpx; font-weight: 800; letter-spacing: 2rpx; }.hero-title { margin-top: 18rpx; color: #5530d6; font-size: 48rpx; font-weight: 800; line-height: 1.25; }.hero-subtitle { margin-top: 14rpx; color: #71668c; font-size: 27rpx; }
.form-group.search-bar { box-sizing: border-box; min-height: 84rpx; margin: 24rpx 0; padding: 0 28rpx; border: 2rpx solid #cdbdff; border-radius: 999rpx; background: #fff; box-shadow: none; }.search-bar { display: flex; align-items: center; }.search-input { box-sizing: border-box; display: block; flex: 1; width: 100%; height: 80rpx; min-height: 80rpx; margin: 0 !important; padding: 0 !important; border: 0 !important; border-radius: 0; background: transparent !important; color: #332456; -webkit-text-fill-color: #332456; opacity: 1; font-size: 28rpx; line-height: 80rpx; }.search-input::placeholder { color: #8a82a2; -webkit-text-fill-color: #8a82a2; opacity: 1; }
.section-title { display: flex; justify-content: space-between; align-items: center; margin: 30rpx 4rpx 16rpx; color: #5630d6; font-size: 29rpx; font-weight: 800; }
.slide { position: relative; display: flex; align-items: center; min-height: 110rpx; padding: 22rpx; border: 2rpx solid #eee7ff; border-radius: 20rpx; background: #fff; }.slide.done { opacity: .62; }.item-info, .mission-info { flex: 1; }.item-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10rpx; margin-left: auto; padding-left: 14rpx; }.item-actions button { flex-shrink: 0; padding: 0 18rpx; font-size: 22rpx; }.item-actions .secondary { background: #dff8ff; color: #1470a5; }
.item-info, .mission-info { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }.item-info_title, .mission-info_title { overflow: hidden; color: #332456; font-size: 31rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }.item-info_award, .mission-info_award { color: #ff4e76; font-size: 25rpx; font-weight: 700; }.item-info_date, .mission-info_date { color: #82799b; font-size: 22rpx; }
.empty { padding: 100rpx 24rpx; text-align: center; }.empty .icon { margin-bottom: 20rpx; color: #ff9f1c; font-size: 80rpx; }.empty .title { color: #5630d6; font-size: 34rpx; font-weight: 800; }
.fab { position: fixed; right: 30rpx; bottom: 130rpx; bottom: calc(130rpx + constant(safe-area-inset-bottom)); bottom: calc(130rpx + env(safe-area-inset-bottom)); width: 116rpx; height: 116rpx; padding: 0; background: linear-gradient(135deg, #2c8cff, #763cff); font-size: 56rpx; line-height: 108rpx; box-shadow: 0 12rpx 28rpx rgba(53,93,230,.35); }
.detail-label { margin-bottom: 8rpx; color: #ff4e76; font-size: 24rpx; font-weight: 800; }.detail-value { color: #332456; font-size: 31rpx; line-height: 1.6; }.form-label { margin: 12rpx 0; color: #5630d6; font-size: 27rpx; font-weight: 800; }
.footer { position: fixed; right: 0; bottom: 0; left: 0; display: flex; gap: 18rpx; padding: 20rpx 28rpx; padding-bottom: calc(20rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); box-shadow: 0 -8rpx 30rpx rgba(97,51,177,.12); z-index: 20; }.footer view { flex: 1; padding: 24rpx; border-radius: 999rpx; text-align: center; }.reset { background: #e7f8ff; color: #1276aa; }.save { background: linear-gradient(110deg, #ff3f78, #ff7b38); color: #fff; }
.balance { margin: 12rpx 4rpx 24rpx; color: #6e6586; font-size: 26rpx; }.balance text { margin-left: 12rpx; color: #ff4e76; font-size: 38rpx; font-weight: 800; }.status-card { border-color: #ffbf4e; background: #fff9e8; }.status-title { margin-bottom: 14rpx; color: #5630d6; font-size: 30rpx; font-weight: 800; }.status-message { margin-bottom: 20rpx; color: #905000; font-size: 26rpx; line-height: 1.6; }
